{
  "pipelineVersion": 4,
  "projectSchemaVersion": 2,
  "languageDefault": "de",
  "aspectRatio": "16:9",
  "fps": 30,
  "resolution": {
    "width": 1920,
    "height": 1080
  },
  "preproductionPolicy": {
    "gateVersion": 1,
    "requiredForNewProjects": true,
    "topicScorecard": "99-technik/TOPIC_SCORECARD.json",
    "storyQc": "99-technik/STORY_QC.json",
    "phase1MustRevalidate": true
  },
  "coverPolicy": {
    "firstSceneIsCover": true,
    "coverImageNumber": 1,
    "coverCandidateCount": 3,
    "separateThumbnailForbidden": true,
    "coverTextRequired": true,
    "coverTextLanguage": "de",
    "coverTextMinWords": 2,
    "coverTextMaxWords": 5,
    "coverTextMustMatchVideo": true,
    "coverTextMustBeHighContrast": true,
    "coverTextMustNotCoverMainSubject": true,
    "rejectMisspelledCoverText": true,
    "userSelectsCover": true,
    "flowMustStopAfterCoverCandidates": true,
    "selectedCoverRequiredBeforeRemainingImages": true,
    "flowMayNotAutoSelectCover": true
  },
  "imagePolicy": {
    "fixedImageCountForbidden": true,
    "oneImageOneVisualPurpose": true,
    "oneNarrativeTakeawayPerImage": true,
    "targetAverageHoldSeconds": [
      2.5,
      4.2
    ],
    "reviewAboveSeconds": 5.5,
    "preferSplitAboveSeconds": 7,
    "hardMaximumSeconds": 9,
    "minimumUsefulHoldSeconds": 1.6,
    "maxConcurrentGenerations": 5,
    "nonCoverGenerationCount": 1,
    "finalImageDirectory": "00-bildprompts/images",
    "storyBeatDrivenPlanning": true,
    "newNarrativeBeatRequiresVisualReview": true,
    "newSubjectActionCauseTimeOrPlaceSuggestsNewVisual": true,
    "visualMustSupportCurrentNarration": true,
    "visualFormMustBeChosenForMeaningNotHabit": true,
    "figuresMustNotBeDefaultFallback": true,
    "multiMomentIllustrationAllowed": true,
    "multiMomentIllustrationMaxMoments": 3,
    "multiMomentMustShareOneTakeaway": true,
    "detailInsetAllowed": true,
    "cutawaySectionAllowed": true,
    "evidenceReconstructionAllowed": true,
    "denseCollageStillForbidden": true,
    "shortVideoVisualGuidance": {
      "approximately60Seconds": [
        18,
        26
      ],
      "approximately90Seconds": [
        24,
        34
      ],
      "approximately120Seconds": [
        32,
        44
      ],
      "guidanceOnly": true,
      "contentDrivenAlwaysWins": true
    }
  },
  "phase2VisualQcPolicy": {
    "requiredForNewProjects": true,
    "schemaVersion": 2,
    "hashAlgorithm": "sha256",
    "hashMustMatchReviewedFile": true
  },
  "phase3AssetPolicy": {
    "existingImagesOnly": true,
    "imageGenerationForbidden": true,
    "imageRegenerationForbidden": true,
    "imageEditingForbidden": true,
    "imageReplacementForbidden": true,
    "imageDeletionForbidden": true,
    "imageAdditionForbidden": true,
    "abortOnMissingImage": true,
    "abortOnInvalidImage": true,
    "abortOnCountMismatch": true,
    "abortOnImageMutation": true,
    "agentMustReportErrorInsteadOfRepairing": true,
    "lockManifest": "99-technik/PHASE3_IMAGE_LOCK.json",
    "sourceDirectory": "00-bildprompts/images"
  },
  "audioPolicy": {
    "playbackRate": 1.05,
    "silenceThresholdDb": -35,
    "minimumLongPauseSeconds": 0.24,
    "retainedPauseSeconds": 0.05,
    "loudnessTargetLufs": -16,
    "truePeakDbtp": -1.5,
    "loudnessRangeLra": 11,
    "outputSampleRateHz": 48000,
    "userOriginalMustRemainUntouched": true
  },
  "endHoldPolicy": {
    "minimumSeconds": 1.2,
    "targetSeconds": 1.3,
    "maximumSeconds": 1.5
  },
  "renderPolicy": {
    "codec": "h264",
    "crf": 18,
    "backgroundMusic": false,
    "subtitles": false
  },
  "exportPolicy": {
    "finalVideoFile": "03-export/FINAL_VIDEO.mp4",
    "thumbnailFile": "03-export/THUMBNAIL.png",
    "captionFile": "03-export/CAPTION.txt",
    "captionRequired": true,
    "captionContainsTitle": true,
    "captionContainsDescription": true,
    "captionMayContainHashtags": true,
    "captionMayContainKeywords": false,
    "thumbnailTextIncludedInCaption": false,
    "subtitleFile": "03-export/SUBTITLES.srt",
    "subtitleRequired": true,
    "subtitleTimingSource": "whisper-aligned-scene-cards",
    "futureCaptionPolicyVersion": 2,
    "captionDescriptionMinimumCharacters": 450,
    "captionDescriptionMaximumCharacters": 1400,
    "captionDescriptionMinimumParagraphs": 2,
    "captionRequiredHashtagsForV2": 5
  },
  "continuousImprovementPolicy": {
    "version": 1,
    "highestPriority": true,
    "reviewFile": "99-technik/POST_VIDEO_REVIEW.json",
    "reviewCommand": "npm run review:youtube -- --dir <projekt> --validate",
    "trigger": "AFTER_SUCCESSFUL_FINAL_EXPORT",
    "blockNewProjectWhenPending": true,
    "blockNewPhase1WhenOtherExportUnreviewed": true,
    "minimumConcreteFindings": 3,
    "minimumVerifiedImprovements": 1,
    "minimumCarryForwardLessons": 2,
    "requiredProof": "FINAL_VIDEO_SHA256 + TIMECODES + ROOT_CAUSE + COMMITTED_CHANGE + REGRESSION_TEST + CI"
  }
}
